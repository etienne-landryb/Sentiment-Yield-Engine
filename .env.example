# Data mode:
#   demo     — synthetic data, no keys/network/DB
#   snapshot — read the committed data/snapshot (backfilled + refreshed daily out of
#              band); no live GDELT on the request path. RECOMMENDED for deployment.
#              Falls back to demo automatically if the snapshot is missing/empty.
#   live     — fetch GDELT/FRED/Twelve Data on the request path (local/dev only)
DATA_MODE=demo

# National equity indices (Twelve Data, free tier: 800/day, 8/min). FRED is keyless.
TWELVE_DATA_API_KEY=

# GDELT sentiment via BigQuery — used ONLY by scripts/ (backfill/refresh/profiler),
# never the app. Path to a GCP service-account JSON key (BigQuery Job User + Data
# Viewer). In CI, store the JSON as secret GCP_SA_KEY and the workflow writes it out.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional LLM (grounded summaries). If GROQ_API_KEY is unset, the summary falls
# back to the deterministic Python-computed facts and never raises. The quantitative
# pipeline never needs this.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b   # reasoning model: summaries.py sets reasoning_effort=low, include_reasoning=False for it

# Optional persistence (Phase 7). App is fully functional with these unset.
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
